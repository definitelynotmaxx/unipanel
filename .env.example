# UniPanel environment configuration (all optional)
# See README for details.

# Server listen address (default: 0.0.0.0:8080)
# UNIPANEL_BIND=0.0.0.0:8080

# Data directory (default: ./data)
# UNIPANEL_DATA_DIR=./data

# Database URL (default: sqlite file inside data dir)
# UNIPANEL_DATABASE_URL=sqlite:///./data/unipanel.db

# Master key (base64, 32 bytes). Auto-generated on first run otherwise.
# UNIPANEL_MASTER_KEY=

# Path to a file containing the master key (base64).
# UNIPANEL_MASTER_KEY_FILE=/path/to/master.key

# Trust X-Forwarded-* headers (default: false)
# UNIPANEL_TRUST_PROXY=false

# Force Secure cookies (default: true if PUBLIC_URL starts with https://)
# UNIPANEL_COOKIE_SECURE=

# Publicly visible URL (used for logs and future emails)
# UNIPANEL_PUBLIC_URL=https://panel.example.com

# Log level (default: info), trailing RUST_LOG filter syntax supported.
# UNIPANEL_LOG=info